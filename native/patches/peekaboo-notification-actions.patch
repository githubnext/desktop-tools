diff --git a/Core/PeekabooAutomationKit/Tests/PeekabooAutomationKitTests/NotificationCenterCustomActionsTests.swift b/Core/PeekabooAutomationKit/Tests/PeekabooAutomationKitTests/NotificationCenterCustomActionsTests.swift
