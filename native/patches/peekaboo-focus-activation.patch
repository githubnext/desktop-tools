diff --git a/Core/PeekabooAutomationKit/Tests/PeekabooAutomationKitTests/FocusActivationObservationTests.swift b/Core/PeekabooAutomationKit/Tests/PeekabooAutomationKitTests/FocusActivationObservationTests.swift
