diff --git a/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/Support/LockFileHolders.swift b/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/Support/LockFileHolders.swift
