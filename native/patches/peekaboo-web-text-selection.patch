diff --git a/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/UI/WebTextSelection.swift b/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/UI/WebTextSelection.swift
