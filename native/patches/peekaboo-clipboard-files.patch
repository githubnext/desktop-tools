+++ b/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/System/ClipboardFilesContents.swift
@@ -0,0 +1,13 @@
+import Foundation
+
+/// Advertised file references only; paths are decoded without accessing the filesystem.
+public struct ClipboardFilesContents: Codable, Sendable {
+    public let present: Bool
+    public let files: [File]?
+    public let change_count: Int
+
+    public struct File: Codable, Sendable {
+        public let url: String
+        public let path: String
+    }
+}
diff --git a/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/System/ClipboardService.swift b/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/System/ClipboardService.swift
