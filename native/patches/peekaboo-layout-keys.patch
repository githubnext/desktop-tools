+        let azerty = Self.layout([0x0C: "a", 0x2E: ",", 0x2B: ";"], shifted: [0x2B: "."])
+
+        let a = try HotkeyService.HotkeyChord(keys: ["cmd", "char:61"], layout: azerty).plan
+        let comma = try HotkeyService.HotkeyChord(keys: ["char:2c"], layout: azerty).plan
