+import AppKit
+import Foundation
+import PeekabooFoundation
+import XCTest
+@testable import PeekabooAutomationKit
+
+@MainActor
+final class ClipboardAttachmentWriteTests: XCTestCase {
+    private let urls = ["file:///tmp/first.png", "file:///tmp/second%20report.pdf"]
+
+    func testReplacingWriteNeverReadsThePriorClipboardAndHasNothingToRestore() throws {
+        let pasteboard = NSPasteboard.withUniqueName()
+        defer { pasteboard.releaseGlobally() }
+        pasteboard.clearContents()
+        XCTAssertTrue(pasteboard.setString("synthetic prior", forType: .string))
+        var policyReads = 0
+        let service = ClipboardService(pasteboard: pasteboard, readAccessStatusReader: { _ in
+            policyReads += 1
+            return .init(policy: .alwaysDeny)
+        })
+
+        let transaction = service.prepareReplacingWrite()
+        _ = try transaction.write(ClipboardWriteRequest(fileURLs: self.urls))
+
+        XCTAssertEqual(policyReads, 0)
+        XCTAssertFalse(transaction.priorClipboardPresent)
+        XCTAssertTrue(transaction.didMutate)
+        XCTAssertEqual(pasteboard.pasteboardItems?.map { $0.data(forType: .fileURL) }, self.urls.map { Data($0.utf8) })
+        XCTAssertNil(pasteboard.string(forType: .string))
+        XCTAssertThrowsError(try transaction.cleanup())
+        XCTAssertEqual(pasteboard.pasteboardItems?.count, 2)
+    }
+
+    func testTemporaryFilesWriteRestoresThePriorClipboard() throws {
+        let pasteboard = NSPasteboard.withUniqueName()
+        defer { pasteboard.releaseGlobally() }
+        pasteboard.clearContents()
+        XCTAssertTrue(pasteboard.setString("synthetic prior", forType: .string))
+        let service = ClipboardService(pasteboard: pasteboard, readAccessStatusReader: { _ in .init(policy: .alwaysAllow) })
+
+        let transaction = try service.prepareTemporaryWrite()
+        _ = try transaction.write(ClipboardWriteRequest(fileURLs: self.urls))
+        XCTAssertEqual(pasteboard.pasteboardItems?.count, 2)
+
+        XCTAssertEqual(try transaction.cleanup().status, .restored)
+        XCTAssertEqual(pasteboard.string(forType: .string), "synthetic prior")
+        XCTAssertEqual(pasteboard.pasteboardItems?.count, 1)
+    }
+
+    func testTemporaryFilesWriteKeepsNewerContents() throws {
+        let pasteboard = NSPasteboard.withUniqueName()
+        defer { pasteboard.releaseGlobally() }
+        pasteboard.clearContents()
+        XCTAssertTrue(pasteboard.setString("synthetic prior", forType: .string))
+        let service = ClipboardService(pasteboard: pasteboard, readAccessStatusReader: { _ in .init(policy: .alwaysAllow) })
+
+        let transaction = try service.prepareTemporaryWrite()
+        _ = try transaction.write(ClipboardWriteRequest(fileURLs: self.urls))
+        pasteboard.clearContents()
+        XCTAssertTrue(pasteboard.setString("synthetic newer", forType: .string))
+
+        XCTAssertEqual(try transaction.cleanup().status, .preservedNewerContents)
+        XCTAssertEqual(pasteboard.string(forType: .string), "synthetic newer")
+    }
+}
diff --git a/Core/PeekabooCore/Sources/PeekabooBridge/PeekabooBridgeAttachmentInsert.swift b/Core/PeekabooCore/Sources/PeekabooBridge/PeekabooBridgeAttachmentInsert.swift
new file mode 100644
index 000000000..9f87d5c81
--- /dev/null
+++ b/Core/PeekabooCore/Sources/PeekabooBridge/PeekabooBridgeAttachmentInsert.swift
@@ -0,0 +1,56 @@
+import Foundation
+import PeekabooAutomationKit
+import PeekabooFoundation
+
+/// One image, or file references, pasted into the snapshot's focused receiver through a temporary clipboard.
+public struct PeekabooBridgeAttachmentInsertRequest: Codable, Sendable {
+    public let snapshot: String
+    public let image: Data?
+    public let paths: [String]?
+    /// Leaves the paste on the clipboard: no copy of the prior contents and no paste reservation.
+    public let replace: Bool
+
+    public init(snapshot: String, image: Data?, paths: [String]?, replace: Bool) {
+        self.snapshot = snapshot; self.image = image; self.paths = paths; self.replace = replace
+    }
+}
+
+extension PeekabooBridgeClient {
+    public func attachmentInsert(
+        snapshot: String, image: Data?, paths: [String]?, replace: Bool) async throws -> PeekabooBridgeLiteralInsertResult
+    {
+        switch try await self.send(.attachmentInsert(.init(snapshot: snapshot, image: image, paths: paths, replace: replace))) {
+        case let .literalInsert(result): return result
+        case let .error(error): throw error
+        default: throw PeekabooBridgeErrorEnvelope(code: .internalError, message: "Unexpected attachment insertion response")
+        }
+    }
+}
+
+@MainActor
+extension PeekabooBridgeServer {
+    func handleAttachmentInsert(_ request: PeekabooBridgeRequest) async throws -> PeekabooBridgeHandledResponse {
+        try PeekabooBridgeRequestContext.checkRequestIsActive()
+        guard case let .attachmentInsert(payload) = request, (payload.image == nil) != (payload.paths == nil) else {
+            throw Self.invalidRequest(for: request)
+        }
+        let attachment: AttachmentPastePayload
+        if let data = payload.image {
+            let decoding = Task.detached(priority: .userInitiated) { try ClipboardImageInput.validate(data) }
+            attachment = try await .image(withTaskCancellationHandler {
+                try await decoding.value
+            } onCancel: {
+                decoding.cancel()
+            })
+        } else {
+            attachment = try .files(ClipboardFilesInput.validate(payload.paths ?? []))
+        }
+        try PeekabooBridgeRequestContext.checkRequestIsActive()
+        return try await self.handleGuardedPaste(snapshot: payload.snapshot) { target in
+            guard let service = self.services.automation as? any AttachmentInsertServiceProtocol else { return nil }
+            return try await service.attachmentInsert(
+                attachment, replace: payload.replace, target: target, clipboard: self.literalInsertClipboard,
+                checkActive: { try PeekabooBridgeRequestContext.checkRequestIsActive() })
+        }
+    }
+}
