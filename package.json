{
	"name": "@githubnext/desktop-tools",
	"version": "0.17.1",
	"description": "Signed macOS desktop inspection and input for agents, with a pure Swift host and MCP server",
	"license": "MIT",
	"type": "module",
	"repository": "github:githubnext/desktop-tools",
	"engines": { "node": ">=22" },
	"exports": {
		".": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
		"./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
		"./tools": { "types": "./dist/tools.d.ts", "default": "./dist/tools.js" },
		"./package.json": "./package.json"
	},
	"bin": { "desktop-tools-build": "dist/build.js", "desktop-tools-app": "dist/app.js", "desktop-tools-mcp": "dist/mcp.js" },
	"files": ["dist", "native/Package.swift", "native/Package.resolved", "native/sources", "native/resources", "native/vendor/Peekaboo/Package.swift", "native/vendor/Peekaboo/LICENSE", "native/vendor/Peekaboo/Core/PeekabooFoundation/Sources", "native/vendor/Peekaboo/Core/PeekabooProtocols/Sources", "native/vendor/Peekaboo/Core/PeekabooAutomationKit/Sources", "native/vendor/Peekaboo/Core/PeekabooCore/Sources/PeekabooBridge", "native2/Package.swift", "native2/Sources", "LICENSE", "README.md"],
	"scripts": {
		"build:js": "tsc",
		"test": "node --test 'test/*.test.mjs'",
		"check": "rm -rf .check && tsc --outDir .check && diff -r .check dist && rm -rf .check",
		"build:native": "node dist/build.js --out build",
		"build:app": "node dist/app.js --out build",
		"dev-app": "node dist/dev-app.js",
		"live-check": "node scripts/live-check.mjs",
		"peekaboo-test": "node scripts/peekaboo-test.mjs"
	},
	"devDependencies": {
		"@types/node": "24.19.0",
		"typescript": "7.0.2"
	}
}
